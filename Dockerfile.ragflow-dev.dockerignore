# Dedicated build context allowlist. Do not alter the production .dockerignore.
**
!Dockerfile.ragflow-dev
!backend/
!backend/requirements-ragflow.txt
!backend/requirements-ragflow-full.txt
!backend/ragflow_derived/
!backend/ragflow_derived/**
!backend/ragflow_dev/
!backend/ragflow_dev/**
!dev/
!dev/ragflow/
!dev/ragflow/requirements-native.txt
!dev/ragflow/prepare_assets.py
!dev/ragflow/start.py
!dev/ragflow/native_acceptance.py
!dev/ragflow/acceptance_job.py
!dev/ragflow/expanded_acceptance.py
!dev/ragflow/generic_holdout_b.json
!dev/ragflow/generic_holdout_c.json
!dev/ragflow/full_acceptance.py
!dev/ragflow/full_port_freeze.json
!dev/ragflow/provider_diagnostic.py
!dev/ragflow/native_tool_compatibility.py
!dev/ragflow/model_selected_dispatch.py
!dev/ragflow/model_selected_fixture.jsonl
!third_party/
!third_party/ragflow/
!third_party/ragflow/**
!third_party/ragflow_port_manifest.json
**/__pycache__/**
**/*.pyc
**/.env*
