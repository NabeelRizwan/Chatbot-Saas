# Runtime
APP_ENV=development
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/chatbot_saas

# Authentication: generate a long, random value before production.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
BOOTSTRAP_ADMIN_EMAIL=

# Refresh sessions use an HttpOnly cookie. For cross-site frontend/API
# deployments use SameSite=none, Secure=true, and an explicit auth allowlist.
REFRESH_COOKIE_NAME=chatbot_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
AUTH_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Set false after running scripts/migrate_byok_keys.py in production.
ALLOW_LEGACY_PLAINTEXT_BYOK=true

# Model providers. Configure the provider(s) used by your bots.
GEMINI_API_KEY=
OPENAI_API_KEY=
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Firecrawl website ingestion. The worker, not the frontend/API process, performs crawls.
FIRECRAWL_API_KEY=
FIRECRAWL_API_BASE=https://api.firecrawl.dev
MAX_CRAWL_PAGES=20
MAX_DEPTH=2
CRAWL_TIMEOUT=120

# Required when using platform-managed provider keys. Generate once and retain it:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLATFORM_KEY_ENCRYPTION_KEY=

CORS_ALLOWED_ORIGINS=*
# Browser widget access is authorized per bot using allowed_origins. Requests
# without Origin/Referer are disabled by default in production.
PUBLIC_DIRECT_API_ENABLED=false
KNOWLEDGE_MAX_UPLOAD_MB=20

# Redis & Distributed Queue Settings
REDIS_URL=redis://127.0.0.1:6379/0
# Production requires arq. The background mode is development-only.
INGESTION_QUEUE_MODE=background
ARQ_QUEUE_NAME=ingestion
QUEUE_CONNECT_TIMEOUT_SECONDS=5
WORKER_MAX_TRIES=3
WORKER_JOB_TIMEOUT=1800
WORKER_MAX_JOBS=10
# Readiness requires this Redis heartbeat in production ARQ mode.
WORKER_HEARTBEAT_INTERVAL=15
WORKER_HEARTBEAT_TTL=60
# Must remain longer than the complete chat request + provider retry envelope.
# The application enforces a one-hour minimum even if configured lower.
MESSAGE_RESERVATION_STALE_SECONDS=3600
ALLOW_DETERMINISTIC_EMBEDDING_FALLBACK=true
REDIS_SOCKET_TIMEOUT=2.0
REDIS_CONNECT_TIMEOUT=2.0
REDIS_MAX_CONNECTIONS=50

# Distributed Rate Limiting (Requests / Window in seconds)
RATE_LIMIT_PUBLIC_CHAT_MAX=30
RATE_LIMIT_PUBLIC_CHAT_WINDOW=60
RATE_LIMIT_AUTH_CHAT_MAX=120
RATE_LIMIT_AUTH_CHAT_WINDOW=60
RATE_LIMIT_CRAWL_MAX=10
RATE_LIMIT_CRAWL_WINDOW=3600
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_UPLOAD_WINDOW=3600
RATE_LIMIT_ADMIN_MAX=300
RATE_LIMIT_ADMIN_WINDOW=60

# Distributed Concurrency Semaphores
GLOBAL_MAX_CRAWLS=5
PER_ORG_MAX_CRAWLS=2
GLOBAL_MAX_LLM_REQUESTS=50
PER_ORG_MAX_LLM_REQUESTS=10
GLOBAL_MAX_EMBEDDING_REQUESTS=20
PER_ORG_MAX_EMBEDDING_REQUESTS=5
SEMAPHORE_DEFAULT_TTL=60

# LLM & Embedding Resilience Configuration
LLM_TIMEOUT=30.0
LLM_CONNECT_TIMEOUT=5.0
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE=1.0
LLM_BACKOFF_MAX=10.0
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RECOVERY_TIMEOUT=30.0
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RATE_LIMIT_MAX_RETRIES=1
EMBEDDING_MAX_RETRY_DELAY_SECONDS=30
EMBEDDING_BATCH_SIZE=20

# Database Connection Pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Production override checklist:
# APP_ENV=production
# INGESTION_QUEUE_MODE=arq
# ALLOW_DETERMINISTIC_EMBEDDING_FALLBACK=false
# REFRESH_COOKIE_SECURE=true
# CORS_ALLOWED_ORIGINS=https://app.example.com
# AUTH_ALLOWED_ORIGINS=https://app.example.com
# FRONTEND_URL=https://app.example.com
# ALLOW_LEGACY_PLAINTEXT_BYOK=false
