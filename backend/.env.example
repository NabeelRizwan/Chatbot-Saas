# Runtime
APP_ENV=development
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/chatbot_saas

# Authentication: generate a long, random value before production.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Model providers. Configure the provider(s) used by your bots.
GEMINI_API_KEY=
OPENAI_API_KEY=
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=text-embedding-004
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Required when using platform-managed provider keys. Generate once and retain it:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLATFORM_KEY_ENCRYPTION_KEY=

# Comma-separated browser origins. Keep * when widgets are embedded on arbitrary customer sites.
CORS_ALLOWED_ORIGINS=*
KNOWLEDGE_MAX_UPLOAD_MB=20
