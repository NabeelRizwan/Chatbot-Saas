# CORE
APP_ENV=development

# DATABASE — PostgreSQL with pgvector
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/chatbot_saas
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# REDIS — cache, rate limits, concurrency, ARQ, worker heartbeat
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_TIMEOUT=2.0
REDIS_CONNECT_TIMEOUT=2.0
REDIS_MAX_CONNECTIONS=50

# OBJECT STORAGE — local is development/test only; production must use s3
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_DIR=storage/knowledge
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=
KNOWLEDGE_MAX_UPLOAD_MB=20

# CRAWLER — Firecrawl is the active adapter
CRAWLER_PROVIDER=firecrawl
FIRECRAWL_API_KEY=
FIRECRAWL_API_BASE=https://api.firecrawl.dev
MAX_CRAWL_PAGES=20
MAX_DEPTH=2
CRAWL_TIMEOUT=120

# GENERATION PROVIDERS — configure only providers used by bots
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
LLM_TIMEOUT=30.0
LLM_CONNECT_TIMEOUT=5.0
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE=1.0
LLM_BACKOFF_MAX=10.0
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RECOVERY_TIMEOUT=30.0

# EMBEDDING PROVIDER — independent from each bot's generation provider
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ALLOW_DETERMINISTIC_EMBEDDING_FALLBACK=true
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RATE_LIMIT_MAX_RETRIES=1
EMBEDDING_MAX_RETRY_DELAY_SECONDS=30
EMBEDDING_BATCH_SIZE=20

# AUTH AND CREDENTIAL ENCRYPTION
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Promote an existing account using scripts/set_platform_admin.py; no admin env bypass.
REFRESH_COOKIE_NAME=chatbot_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
ALLOW_LEGACY_PLAINTEXT_BYOK=true
# Generate once and retain: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLATFORM_KEY_ENCRYPTION_KEY=

# CORS / PUBLIC ACCESS
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PUBLIC_DIRECT_API_ENABLED=false

# QUEUE / WORKER — production requires arq
INGESTION_QUEUE_MODE=background
ARQ_QUEUE_NAME=ingestion
QUEUE_CONNECT_TIMEOUT_SECONDS=5
WORKER_MAX_TRIES=3
WORKER_JOB_TIMEOUT=1800
WORKER_MAX_JOBS=10
WORKER_KEEP_RESULT_SECONDS=3600
WORKER_HEALTHCHECK_INTERVAL=30
WORKER_HEARTBEAT_INTERVAL=15
WORKER_HEARTBEAT_TTL=60
MESSAGE_RESERVATION_STALE_SECONDS=3600

# RATE LIMITS / DISTRIBUTED CONCURRENCY
RATE_LIMIT_PUBLIC_CHAT_MAX=30
RATE_LIMIT_PUBLIC_CHAT_WINDOW=60
RATE_LIMIT_AUTH_CHAT_MAX=120
RATE_LIMIT_AUTH_CHAT_WINDOW=60
RATE_LIMIT_CRAWL_MAX=10
RATE_LIMIT_CRAWL_WINDOW=3600
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_UPLOAD_WINDOW=3600
RATE_LIMIT_ADMIN_MAX=300
RATE_LIMIT_ADMIN_WINDOW=60
GLOBAL_MAX_CRAWLS=5
PER_ORG_MAX_CRAWLS=2
GLOBAL_MAX_LLM_REQUESTS=50
PER_ORG_MAX_LLM_REQUESTS=10
GLOBAL_MAX_EMBEDDING_REQUESTS=20
PER_ORG_MAX_EMBEDDING_REQUESTS=5
SEMAPHORE_DEFAULT_TTL=60

# OBSERVABILITY
CHATBOT_METRICS_LOGS=false

# PRODUCTION REQUIRED OVERRIDES
# APP_ENV=production
# INGESTION_QUEUE_MODE=arq
# OBJECT_STORAGE_PROVIDER=s3
# ALLOW_DETERMINISTIC_EMBEDDING_FALLBACK=false
# ALLOW_LEGACY_PLAINTEXT_BYOK=false
# REFRESH_COOKIE_SECURE=true
# CORS_ALLOWED_ORIGINS=https://app.example.com
# AUTH_ALLOWED_ORIGINS=https://app.example.com
# FRONTEND_URL=https://app.example.com
